{
  "iter": 0,
  "teacher_train_bootstrap": [
    "data/teacher.extxyz"
  ],
  "student_train_bootstrap": [
    "data/student.extxyz"
  ],
  "fp_data": [],
  "teacher": {
    "backend": "MACE",
    "model": "single",
    "type_map": [
      "Al",
      "C",
      "O",
      "H"
    ],
    "recipe": "recipes/teacher.yaml",
    "policy": "from_scratch",
    "valid_frac": 0.0
  },
  "student": {
    "backend": "DeepMD",
    "cli": "pt",
    "model": "single",
    "type_map": [
      "Al",
      "C",
      "O",
      "H"
    ],
    "recipe": "recipes/student.json",
    "policy": "from_scratch",
    "valid_frac": 0.0
  },
  "sampler": {
    "backend": "LAMMPS"
  },
  "sample": {
    "round_count": 1,
    "seeds": {
      "A": {
        "source": "data/host.extxyz",
        "selection_group": "joint"
      }
    },
    "condition_groups": {
      "insert": {
        "kind": "widom",
        "guest": "data/guest.extxyz",
        "frames": 3,
        "max_attempts": 30,
        "random_seed": 42,
        "overlap": {
          "scale": 0.6
        }
      }
    }
  },
  "screen": {
    "pool": 2,
    "keep": 1,
    "fp_pool": 2,
    "policy": "random"
  },
  "fp": {
    "keep": 1,
    "policy": "random"
  },
  "visualize": false
}
