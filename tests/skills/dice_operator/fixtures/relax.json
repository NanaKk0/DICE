{
  "schema": "dice.execution-profile",
  "targets": {
    "local": {
      "adapter": "local",
      "max_in_flight": 1
    }
  },
  "target_pools": {
    "local-only": {
      "targets": [
        "local"
      ]
    }
  },
  "resource_classes": {
    "relax-mps": {
      "mode": "pool",
      "nodes": 1,
      "processes_per_node": 1,
      "gpus_per_node": 1,
      "per_gpu": 2,
      "cpus_per_process": 4,
      "memory_mb": 16384,
      "wall_time_seconds": 3600,
      "launcher": {
        "kind": "direct"
      }
    }
  },
  "bindings": [
    {
      "operation_role": "student.deepmd.tf.relax",
      "resource_class": "relax-mps",
      "target_pool": "local-only"
    },
    {
      "operation_role": "student.deepmd.pt.relax",
      "resource_class": "relax-mps",
      "target_pool": "local-only"
    }
  ]
}
